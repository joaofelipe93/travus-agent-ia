OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PIPERUN_HASH=
GOOGLE_SA_KEY_FILE=/opt/travus-bot/google-credentials.json
GOOGLE_CALENDAR_ID=luiz.muniz@travuscapital.com.br
GOOGLE_IMPERSONATE_USER=luiz.muniz@travuscapital.com.br

# Buffer de mensagens em rajada (todos opcionais — tem defaults sensatos)
# COALESCE_DELAY_MS=4000     # espera entre mensagens (default 4s)
# COALESCE_MAX_MS=30000      # timeout máximo do buffer (default 30s)
# COALESCE_MAX_COUNT=10      # limite de mensagens no buffer (default 10)

# API do webhook (Piperun → Travus)
API_PORT=3000
WEBHOOK_PDF_PATH=assets/material.pdf
WEBHOOK_PDF_FILENAME=Travus Capital.pdf

# Webhook de novo cliente da Landing Page (chama API do Piperun)
PIPERUN_API_TOKEN=
# PIPERUN_NEW_CLIENT_DESTINATION_STAGE_ID=648382   # default: stage "Abertura"
# NOVO_CLIENTE_REQUIRED_ORIGIN=LP V2               # só dispara fluxo se origin.name bater
# PIPERUN_CONNECTION_STAGE_ID=648383               # stage "Conexão" — pro qual movemos após agendar

# Resposta automática quando lead já está com agendamento confirmado
# (use {{nome_sufixo}} ou {{primeiro_nome}})
# SCHEDULED_REPLY_TEMPLATE=Oi{{nome_sufixo}}! Seu agendamento já tá confirmado 😊...

# Rotina mensal de boletos (consórcio Canopus)
# PIPERUN_BOLETOS_STAGE_ID=679217                  # etapa do CRM com os clientes elegíveis
# BOLETOS_CRON=0 9 10 * *                          # cron (TZ America/Sao_Paulo): default dia 10 às 09:00
# BOLETOS_ENABLED=true                             # set "false" pra desativar o cron
# BOLETOS_PACING_MS=3000                           # ms entre clientes processados (default 3s)
# BOLETOS_BILL_PACING_MS=1500                      # ms entre bills do mesmo cliente (default 1.5s) — evita 429
# CANOPUS_MAX_RETRIES=3                            # tentativas em 429/5xx no print-overdue-bill
# CANOPUS_RETRY_BASE_MS=2000                       # backoff exponencial: 2s, 4s, 8s
# CANOPUS_USER_AGENT=                              # custom UA; default mimica Chrome no Linux
# CANOPUS_BASE_URL=                                # proxy alternativo (ex: Cloudflare Worker) se IP da VPS for barrado pelo WAF
# CANOPUS_PROXY_TOKEN=                             # token compartilhado com o Worker (header x-proxy-token)
# BOLETOS_MESSAGE_TEMPLATE=Oi, {{primeiro_nome}}! 😊\n\nTô te mandando {{boletos_label}} desse mês 📄...
# Placeholders disponíveis:
#   {{primeiro_nome}} → primeiro nome em title case (ex: "Luiz")
#   {{boletos_label}} → "o boleto" (1) ou "os boletos" (2+)
#   {{anexo_label}}   → "Anexo o boleto" (1) ou "Anexo os boletos" (2+) — mantido por compatibilidade