OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PIPERUN_HASH=

# Token do dashboard admin (GET /admin/dashboard e /admin/dashboard.json).
# Obrigatório — se não configurado, o endpoint retorna 503 (fail-safe pra
# não deixar dashboard aberto por engano). Header esperado: x-admin-token
# ADMIN_TOKEN=

# Nível do logger interno (src/utils/logger.js). Padrão: info.
# Valores aceitos: debug | info | warn | error | silent
# LOG_LEVEL=info

# Banco Inter — emissão de boleto via API (mTLS + OAuth2)
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CONTA_CORRENTE=
INTER_CERT_FILE=secrets/inter/inter.crt
INTER_KEY_FILE=secrets/inter/inter.key
# INTER_BASE_URL=https://cdpj-sandbox.partners.uatinter.co   # sandbox (default)
# INTER_BASE_URL=https://cdpj.partners.bancointer.com.br    # produção

# Webhook de emissão de contrato — quando um deal entra na etapa de "Emissão de Contrato"
# o bot emite boleto na Inter e envia pelo WhatsApp
# INTER_CONTRATO_STAGE_ID=654265                   # stage do Piperun que dispara
# INTER_CONTRATO_MULTA_PCT=2                       # multa (%)
# INTER_CONTRATO_MORA_PCT=1                        # mora ao mês (%)
# INTER_CONTRATO_VENC_PRIMEIRA_DIAS=1              # vencimento da 1ª parcela (dias após emissão)
# As demais parcelas mantêm o MESMO DIA DO MÊS da 1ª, avançando 1 mês a cada.
# Se o mês alvo não tem o dia (ex: dia 31 → fev), usa último dia do mês.
# INTER_COBRANCA_DELAY_MS=500                      # ms entre POSTs na Inter (evita rate limit)
# INTER_PDF_DELAY_MS=1500                          # ms entre downloads de PDF / envios no WhatsApp
# CONTRATO_MESSAGE_TEMPLATE=Oi, {{primeiro_nome}}! 😊...
# Placeholders: {{primeiro_nome}}, {{total_parcelas}}, {{valor}}
#
# Valor + parcelas do contrato vêm do campo "observation" do payload do
# webhook (texto livre preenchido pelo consultor no CRM). Formato esperado:
#   "Valor do contrato de consultoria:\nR$300 x12"
# Regex: R\$\s*([\d.,]+)\s*x\s*(\d+) — extrai valor e quantidade de parcelas.
#
# Modo CORTESIA: se o observation contiver "Sem cobrança", o bot pula a
# emissão de boletos na Inter e envia apenas o contrato em PDF (com a
# Cláusula 4ª removida).
# CONTRATO_MESSAGE_TEMPLATE_CORTESIA=Oi, {{primeiro_nome}}! 😊 Segue o seu contrato...
# Placeholders: {{primeiro_nome}}

# Número do consultor que recebe alertas de erro (deal sem endereço, etc)
# CONSULTOR_WHATSAPP=55XX9NNNNNNNN

# Nome do consultor usado nos templates de mensagem (ex: lembrete t15min).
# Se vazio, template usa "nosso especialista" genérico.
# CONSULTOR_NOME=Nome do Consultor

# Contrato em .docx
# CONTRATO_TEMPLATE_PATH=src/assets/contrato-template.docx     # default; sobrescrever só se mudar caminho
# CONTRATO_FORMAT=docx                                          # default — envia .docx
# CONTRATO_FORMAT=pdf                                           # envia PDF via ConvertAPI (exige CONVERTAPI_TOKEN)

# Conversão de .docx → PDF via ConvertAPI cloud (https://www.convertapi.com).
# Necessário quando CONTRATO_FORMAT=pdf. Free tier: 1500 segundos/mês.
# CONVERTAPI_TOKEN=

# Cron diário de lembretes das parcelas (2ª em diante) do contrato — envia o
# boleto pelo WhatsApp X dias antes do vencimento. Refs #100.
# CONTRATO_REMINDER_ENABLED=true
# CONTRATO_REMINDER_CRON=0 9 * * *                                # default: todo dia às 09:00 BRT
# CONTRATO_REMINDER_WINDOW_DIAS=10                                # default: envia se vencer em até 10 dias
# CONTRATO_REMINDER_PACING_MS=1500                                # ms entre envios pra evitar rate limit
# CONTRATO_REMINDER_TEMPLATE=Oi, {{primeiro_nome}}! 😊 Segue o boleto da consultoria...
# Placeholders: {{primeiro_nome}}, {{parcela_n}}, {{total_parcelas}}, {{data_vencimento}}

# Cron de baixa de pagamento + atrasos (Refs #98)
# Consulta status na Inter pra cada parcela com pdf_sent=1 AND paid_at IS NULL.
# Manda lembrete escalonado em D+1, D+5, D+15. No D+15 notifica o CONSULTOR_WHATSAPP.
# ATRASO_ENABLED=true
# ATRASO_CRON=0 9 * * *                                   # diário 09:00 BRT (default)
# ATRASO_DIAS_NIVEL_1=1                                   # D+1 (default)
# ATRASO_DIAS_NIVEL_2=5                                   # D+5 (default)
# ATRASO_DIAS_NIVEL_3=15                                  # D+15 (default)
# ATRASO_PACING_MS=1500                                   # ms entre envios pelo WhatsApp
# ATRASO_INTER_CHECK_PACING_MS=300                        # ms entre consultas na Inter
# ATRASO_TEMPLATE_D1=...                                   # template do D+1 (placeholders: primeiro_nome, parcela_n, total_parcelas, data_vencimento)
# ATRASO_TEMPLATE_D5=...
# ATRASO_TEMPLATE_D15=...
# ATRASO_TEMPLATE_CONSULTOR=...                            # placeholders extras: cliente_nome, deal_id
# Concordância de gênero: o template é feminino. Quando person.gender == "Masculino"
# no payload do Piperun, as palavras (brasileira/inscrita/assessorá-la/informada)
# são substituídas em memória pela versão masculina antes de renderizar.
GOOGLE_SA_KEY_FILE=/opt/travus-bot/google-credentials.json
GOOGLE_CALENDAR_ID=luiz.muniz@travuscapital.com.br
GOOGLE_IMPERSONATE_USER=luiz.muniz@travuscapital.com.br

# Buffer de mensagens em rajada (todos opcionais — tem defaults sensatos)
# COALESCE_DELAY_MS=4000     # espera entre mensagens (default 4s)
# COALESCE_MAX_MS=30000      # timeout máximo do buffer (default 30s)
# COALESCE_MAX_COUNT=10      # limite de mensagens no buffer (default 10)

# API do webhook (Piperun → Travus)
API_PORT=3000
WEBHOOK_PDF_PATH=src/assets/material.pdf
WEBHOOK_PDF_FILENAME=Travus Capital.pdf

# Webhook de novo cliente da Landing Page (chama API do Piperun)
PIPERUN_API_TOKEN=
# PIPERUN_NEW_CLIENT_DESTINATION_STAGE_ID=648382   # default: stage "Abertura"
# NOVO_CLIENTE_REQUIRED_ORIGIN=LP V2               # só dispara fluxo se origin.name bater
# PIPERUN_CONNECTION_STAGE_ID=648383               # stage "Conexão" — pro qual movemos após agendar

# Resposta automática quando lead já está com agendamento confirmado
# (use {{nome_sufixo}} ou {{primeiro_nome}})
# SCHEDULED_REPLY_TEMPLATE=Oi{{nome_sufixo}}! Seu agendamento já tá confirmado 😊...

# Webhook de confirmação de invite — dispara quando deal é ganho na stage
# 648386 (Agendamento / Prospecção) via ação "Ganhar e Agendar".
# Bot busca o evento no Google Calendar (por deal.title + proximidade
# temporal com closed_at), enriquece a descrição adicionando o telefone
# (pra que o reminder scheduler também funcione), e manda a msg de
# confirmação no WhatsApp. Refs #114.
# CONFIRMACAO_INVITE_STAGE_ID=648386
# CONFIRMACAO_INVITE_TRIGGER_TYPE=Uma oportunidade for ganha
# CONFIRMACAO_INVITE_RETRY_MS=3000          # espera entre tentativas de achar evento
# CONFIRMACAO_INVITE_MAX_RETRIES=3
# CONFIRMACAO_INVITE_LOOKAHEAD_DAYS=60      # janela de busca no Calendar
# CONFIRMACAO_INVITE_CREATED_WINDOW_MS=300000  # 5min de tolerância entre event.created e closed_at
# CONFIRMACAO_INVITE_TEMPLATE=Oi {{primeiro_nome}}, confirmando nosso bate-papo para {{data}} às {{hora}}hrs...
# Placeholders: {{primeiro_nome}}, {{data}} (DD/MM), {{hora}} (HHh ou HH:MM)
# CONFIRMACAO_INVITE_FALLBACK_TEMPLATE=Oi {{primeiro_nome}}, confirmando nosso bate-papo...
# Placeholders: {{primeiro_nome}}

# Rotina mensal de boletos (consórcio Canopus)
# PIPERUN_BOLETOS_STAGE_ID=679217                  # etapa do CRM com os clientes elegíveis
# BOLETOS_CRON=0 9 8 * *                           # cron (TZ America/Sao_Paulo): default dia 8 às 09:00
# BOLETOS_ENABLED=true                             # set "false" pra desativar o cron
# BOLETOS_PACING_MS=3000                           # ms entre clientes processados (default 3s)
# BOLETOS_BILL_PACING_MS=1500                      # ms entre bills do mesmo cliente (default 1.5s) — evita 429
# CANOPUS_MAX_RETRIES=3                            # tentativas em 429/5xx no print-overdue-bill
# CANOPUS_RETRY_BASE_MS=2000                       # backoff exponencial: 2s, 4s, 8s
# CANOPUS_USER_AGENT=                              # custom UA; default mimica Chrome no Linux
# CANOPUS_BASE_URL=                                # proxy alternativo (ex: Cloudflare Worker) se IP da VPS for barrado pelo WAF
# CANOPUS_PROXY_TOKEN=                             # token compartilhado com o Worker (header x-proxy-token)
# BOLETOS_MESSAGE_TEMPLATE=Oi, {{primeiro_nome}}! 😊 Tudo bem?...
# Placeholders disponíveis:
#   {{primeiro_nome}} → primeiro nome em title case (ex: "Luiz")
#   {{boletos_label}} → "o boleto" (1) ou "os boletos" (2+) — disponível pra template custom
#   {{anexo_label}}   → "Anexo o boleto" (1) ou "Anexo os boletos" (2+) — disponível pra template custom